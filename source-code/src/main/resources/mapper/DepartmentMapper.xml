<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.etc.hospital.mapper.DepartmentMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="deptId">
        INSERT INTO department(dept_name,dept_type,is_delete) VALUES(#{deptName},#{deptType},0)
    </insert>
    <update id="updateById">
        UPDATE department
        <set>
            <if test="deptName!=null">dept_name=#{deptName},</if>
            <if test="deptType!=null">dept_type=#{deptType},</if>
        </set>
        WHERE dept_id=#{deptId} AND is_delete=0
    </update>
    <select id="selectById" resultType="com.etc.hospital.entity.Department">
        SELECT * FROM department WHERE dept_id=#{deptId} AND is_delete=0
    </select>
    <select id="selectByName" resultType="com.etc.hospital.entity.Department">
        SELECT * FROM department WHERE dept_name=#{deptName} AND is_delete=0
    </select>
    <select id="selectPage" resultType="com.etc.hospital.entity.Department">
        SELECT * FROM department WHERE is_delete=0
        <if test="name!=null and name!=''">AND dept_name LIKE CONCAT('%',#{name},'%')</if>
    </select>
    <delete id="deleteById">
        DELETE FROM department WHERE dept_id=#{deptId}
    </delete>
</mapper>